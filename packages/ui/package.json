{
  "name": "@aryan_sehgal/forma-ui",
  "version": "0.1.1",
  "description": "Accessible, composable React components with portable CSS tokens.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanSehgal/forma-design-system.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "radix-ui": "^1.4.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
